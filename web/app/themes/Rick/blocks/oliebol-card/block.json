{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rick/oliebol-card",
  "version": "1.0.0",
  "title": "Oliebol Review Kaart (CPT Koppeling)",
  "category": "rick-blocks",
  "icon": "store",
  "description": "Toont automatisch een complete oliebol review kaart gekoppeld aan een Oliebol-bericht uit de database.",
  "keywords": ["oliebol", "oliebollen", "review", "kaart", "score", "cpt", "koppeling"],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "oliebolId": {
      "type": "number",
      "default": 0
    },
    "buttonText": {
      "type": "string",
      "default": "Bekijk Volledige Review"
    }
  },
  "editorScript": "file:./editor.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
